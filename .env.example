# =============================================================================
# RHDH Demo - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Git Credentials (for Tekton pipelines) ---
GIT_USERNAME=your-github-username
GIT_TOKEN=ghp_your_personal_access_token

# --- GitHub App (for RHDH login + integration) ---
# Create a GitHub App at: https://github.com/settings/apps/new
GITHUB_APP_ID=your-app-id
GITHUB_APP_CLIENT_ID=your-app-client-id
GITHUB_APP_CLIENT_SECRET=your-app-client-secret
GITHUB_APP_WEBHOOK_URL=https://smee.io/your-webhook-url
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_PRIVATE_KEY_FILE=./github-app-private-key.pem
GITHUB_ORG=your-github-org

# --- Registry Credentials (Quay.io) ---
REGISTRY_SERVER=quay.io
REGISTRY_USERNAME=your-registry-username
REGISTRY_PASSWORD=your-registry-password-or-token

# --- ArgoCD Configuration ---
ARGOCD_NAMESPACE=openshift-gitops
ARGOCD_USERNAME=admin
# ARGOCD_PASSWORD will be auto-detected from cluster if not set

# --- RHDH Configuration ---
RHDH_NAMESPACE=rhdh

# --- Cluster Configuration ---
# Leave empty to auto-detect from cluster
# CLUSTER_DOMAIN=apps.your-cluster.example.com
